# StormStream Settings
# ====================
#
# Copy this to .env and change anything you want:
#     cp .env.example .env
#
# Who reads this file:
# - docker compose (--env-file .env) and scripts/smoke_test.sh
# - the poller
# The Spark job and the dashboard do not load it. They read the same
# POSTGRES_* names from the environment and fall back to these defaults.

# ── Kafka ────────────────────────────────────────────────────────────
# Address for things running on the laptop
KAFKA_BOOTSTRAP_HOST=localhost:9092
# Address for other containers on the docker network
KAFKA_BOOTSTRAP_INTERNAL=kafka:29092
# The Spark job has this topic name hardcoded
ALERTS_TOPIC=weather-alerts
ALERTS_TOPIC_PARTITIONS=4

# ── Postgres ─────────────────────────────────────────────────────────
POSTGRES_USER=stormstream
POSTGRES_PASSWORD=stormstream
POSTGRES_DB=stormstream
POSTGRES_HOST=localhost
# 15432 on the laptop, 5432 inside the container
POSTGRES_PORT=15432

# ── Poller ───────────────────────────────────────────────────────────
NWS_POLL_INTERVAL_SECONDS=45
# Empty means all of the US, or put a state code like FL
NWS_REGION_FILTER=
