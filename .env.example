# copy this to .env (cp .env.example .env) and change anything you want

# kafka
KAFKA_BOOTSTRAP_HOST=localhost:9092
KAFKA_BOOTSTRAP_INTERNAL=kafka:29092
ALERTS_TOPIC=weather-alerts
ALERTS_TOPIC_PARTITIONS=4

# postgres
POSTGRES_USER=stormstream
POSTGRES_PASSWORD=stormstream
POSTGRES_DB=stormstream
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# poller (used in session 2)
NWS_POLL_INTERVAL_SECONDS=45
NWS_REGION_FILTER=
